ZHIHUA_ENVIRONMENT=development
ZHIHUA_HOST=127.0.0.1
ZHIHUA_PORT=8000
ZHIHUA_COMFYUI_BASE_URL=http://127.0.0.1:8188
ZHIHUA_COMFYUI_TIMEOUT_SECONDS=5
ZHIHUA_COMFYUI_PATH=/root/ComfyUI

# Generate a unique random value of at least 32 characters during deployment.
# Keep it in the desktop credential store and the remote process environment only.
ZHIHUA_SERVICE_TOKEN=

ZHIHUA_JOBS_DATABASE_PATH=/root/.local/share/zhihua-service/jobs.sqlite3
ZHIHUA_MINIMUM_CLIENT_VERSION=0.1.0
ZHIHUA_WORKFLOW_MANIFEST_VERSION=h3-workflows-2026.09.08
ZHIHUA_MODEL_MANIFEST_VERSION=public-models-2026.09.08
ZHIHUA_ALLOWED_WORKFLOWS=h3-t2v-turbo-v1,h3-t2v-high-v1,h3-i2v-turbo-v1,h3-i2v-high-v1,h3-flf2v-turbo-v1,h3-flf2v-high-v1,h3-ref2va-turbo-v1,h3-ref2va-high-v1,seedvr2-1080p-v1,h3-fl2v-turbo-v1
# Trusted ComfyUI API-format workflows and generated output directory
ZHIHUA_WORKFLOW_DIRECTORY=/root/zhihua-service/workflows
ZHIHUA_COMFYUI_OUTPUT_PATH=/root/ComfyUI/output
ZHIHUA_WORKER_POLL_INTERVAL_SECONDS=2
ZHIHUA_WORKER_RETRY_DELAY_SECONDS=30
