{
  "description": "SeedVR2 temporal video enhancement targeting the project 1080 edge",
  "requiredNodeTypes": [
    "SeedVR2LoadDiTModel",
    "SeedVR2LoadVAEModel",
    "SeedVR2VideoUpscaler"
  ],
  "prompt": {
    "1": {
      "class_type": "LoadVideo",
      "inputs": {
        "file": "zhihua-inputs/required-video"
      }
    },
    "2": {
      "class_type": "GetVideoComponents",
      "inputs": {
        "video": [
          "1",
          0
        ]
      }
    },
    "3": {
      "class_type": "SeedVR2LoadDiTModel",
      "inputs": {
        "model": "seedvr2_ema_3b_fp8_e4m3fn.safetensors",
        "device": "cuda:0",
        "blocks_to_swap": 0,
        "swap_io_components": false,
        "offload_device": "cpu",
        "cache_model": false,
        "attention_mode": "sdpa"
      }
    },
    "4": {
      "class_type": "SeedVR2LoadVAEModel",
      "inputs": {
        "model": "ema_vae_fp16.safetensors",
        "device": "cuda:0",
        "encode_tiled": true,
        "encode_tile_size": 1024,
        "encode_tile_overlap": 128,
        "decode_tiled": true,
        "decode_tile_size": 1024,
        "decode_tile_overlap": 128,
        "tile_debug": "false",
        "offload_device": "cpu",
        "cache_model": false
      }
    },
    "5": {
      "class_type": "SeedVR2VideoUpscaler",
      "inputs": {
        "image": [
          "2",
          0
        ],
        "dit": [
          "3",
          0
        ],
        "vae": [
          "4",
          0
        ],
        "seed": 20260908,
        "resolution": 1080,
        "max_resolution": 1920,
        "batch_size": 13,
        "uniform_batch_size": true,
        "color_correction": "lab",
        "temporal_overlap": 3,
        "prepend_frames": 1,
        "input_noise_scale": 0.0,
        "latent_noise_scale": 0.0,
        "offload_device": "cpu",
        "enable_debug": true
      }
    },
    "14": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "5",
          0
        ],
        "audio": [
          "2",
          1
        ],
        "fps": [
          "2",
          2
        ],
        "bit_depth": 8
      }
    },
    "15": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "14",
          0
        ],
        "filename_prefix": "video/zhihua/pending",
        "format": "mp4",
        "codec": "auto"
      }
    }
  },
  "bindings": {
    "seed": [
      [
        "5",
        "inputs",
        "seed"
      ]
    ],
    "sourceVideoFile": [
      [
        "1",
        "inputs",
        "file"
      ]
    ],
    "outputPrefix": [
      [
        "15",
        "inputs",
        "filename_prefix"
      ]
    ]
  },
  "requiredParameters": [
    "sourceVideoFile",
    "outputPrefix"
  ]
}
